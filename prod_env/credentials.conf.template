# Credentials template for AGC-Bench. Copy to credentials.conf and fill in
# the keys needed for your chosen reproduction path.

# Required for the model under evaluation when using OpenRouter.
openrouterApiKey: <YOUR_OPENROUTER_KEY_HERE>

# Required for AGC-Judge served on HF Inference Endpoints.
# Not required for --local-vllm.
huggingfaceApiToken: <YOUR_HF_TOKEN_HERE>

# Required for exact release-cohort parity on embedding-routed metrics, and
# for Google judge configurations when AGC_JUDGE_OVERRIDE is not set.
googleApiKey: <YOUR_GOOGLE_KEY_HERE>

# Optional: required only if you run source-paper judges directly rather than
# routing LLM-judge calls through AGC-Judge.
# anthropicApiKey: <YOUR_ANTHROPIC_KEY_HERE>
# openaiApiKey: <YOUR_OPENAI_KEY_HERE>
